# Shared Discord Bot Credentials (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# 🔑 CRITICAL FOR MULTI-DEVELOPER SERVERS:
# Your personal Discord User ID. Each developer sets their OWN Discord User ID here.
# The container will ONLY execute commands triggered by THIS specific user ID.
MY_USER_ID=123456789012345678

# Default cheap AI model for OpenCode CLI (e.g. deepseek-v4, gemini-3.6-flash, claude-3-7-sonnet)
DEFAULT_MODEL=deepseek-v4

# CLI Agent Tool
AGENT_CLI=opencode

# Host Workspace path to mount in Docker (Default: C:/Users/vdkad or ~/code)
HOST_WORKSPACE_PATH=C:/Users/vdkad
