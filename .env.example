# Discord Bot Credentials (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Security: Comma-separated Discord User IDs allowed to use the bot
# Leave empty to allow all members of your server
ALLOWED_USER_IDS=

# Default cheap AI model for OpenCode CLI (e.g. deepseek-v4, gemini-3.6-flash, claude-3-7-sonnet)
DEFAULT_MODEL=deepseek-v4

# CLI Agent Tool (opencode, aider, or custom wrapper)
AGENT_CLI=opencode

# Base directory for auto-discovering projects on your PC
REPOS_DIR=C:/Users/vdkad

# Optional custom repo mappings (JSON format)
# CUSTOM_REPOS={"EscapeNONE":"C:/Users/vdkad/EscapeNONE","escapenone-web":"C:/Users/vdkad/escapenone-web","project-genesis":"C:/Users/vdkad/project-genesis"}
